)]}'

[["wrb.fr","ErneX","[[[[\"projects/18178749605532028059/files/dfbe0976516945b8ba1922aad4d987dc\",null,\"https://lh3.googleusercontent.com/aida/AP1WRLsBIvwfPr5e7bI3BSgZUE-_3Vy4DoeeVHzmN-YQ1m1Me0xYfolFr95XsjlKgLM3Z6y9UZ4palZ6Zq5sve0rJIO02Ydm2Rwbb-QwZtC2VLEIxFaN-TOMF5lbEQAPAHGN5SQ6O8dJ-oAFffOI8yXqJJ3IjQJEIydu9uB4J-QJTciU-Q6mGBjI2qeISFPerAwCM6VWdHSU7ISV2DxT3BvRUB-TYNsPdXQlgKMYGbqyzrxi7OgGXywsOnGE4mQ\"],[\"projects/18178749605532028059/files/7bfecbb6f05a48b4a531f648d9306b86\",null,\"https://contribution.usercontent.google.com/download?c\\u003dCgthaWRhX2NvZGVmeBJ8Eh1hcHBfY29tcGFuaW9uX2dlbmVyYXRlZF9maWxlcxpbCiVodG1sX2JjMWE0Yjk5NjhiZTQxYmM4YmQxYWU1YWU0N2M5OGRiEgsSBxDv9_C4jw8YAZIBJAoKcHJvamVjdF9pZBIWQhQxODE3ODc0OTYwNTUzMjAyODA1OQ\\u0026filename\\u003d\\u0026opi\\u003d89354086\",null,null,\"text/html\"],null,null,\"9450d12c7764446d80499d579923920d\",\"HatterAgent\",\"2560\",\"3820\",\"Stitch — Danh mục sản phẩm (Updated Navbar)\",\"Update the navbar to match the layout of the homepage (SCREEN_17). \\n1. The logo \\\"STITCH\\\" should be on the far left.\\n2. The main navigation links \\\"Nam\\\", \\\"Nữ\\\", \\\"Sale\\\", \\\"Đơn hàng\\\" must be centered in the header.\\n3. The \\\"Account\\\" and \\\"Cart\\\" icons must be grouped and aligned to the far right.\\n4. Ensure the styling (font-size, uppercase, tracking, and backdrop-blur) matches the latest brand identity in {{DATA:DESIGN_SYSTEM:DESIGN_SYSTEM_1}}.\\n5. Maintain the breadcrumb and category title section (\\\"Trang chủ \\u003e Bộ sưu tập \\u003e Nữ\\\") below the new navbar.\",\"projects/18178749605532028059/screens/9450d12c7764446d80499d579923920d\",[1,null,3,null,\"#c97b5a\",null,null,null,null,null,26,26,[[\"on_tertiary_container\",\"#fffbff\"],[\"surface_container_highest\",\"#e5e2df\"],[\"sage\",\"#D6E4D8\"],[\"inverse_on_surface\",\"#f3f0ed\"],[\"on_tertiary\",\"#ffffff\"],[\"on_surface\",\"#1c1c1a\"],[\"cream-warm\",\"#F2ECE6\"],[\"surface_dim\",\"#dcdad7\"],[\"on_tertiary_fixed_variant\",\"#4a4641\"],[\"surface_variant\",\"#e5e2df\"],[\"outline\",\"#86736c\"],[\"tertiary_fixed\",\"#e9e1da\"],[\"tertiary_fixed_dim\",\"#ccc5bf\"],[\"primary_fixed\",\"#ffdbcd\"],[\"error\",\"#ba1a1a\"],[\"outline_variant\",\"#d9c2b9\"],[\"surface_container\",\"#f0edea\"],[\"secondary\",\"#655d58\"],[\"on_secondary_container\",\"#69615c\"],[\"secondary_fixed\",\"#ece0da\"],[\"on_error_container\",\"#93000a\"],[\"secondary_fixed_dim\",\"#cfc4be\"],[\"on_background\",\"#1c1c1a\"],[\"error_container\",\"#ffdad6\"],[\"inverse_primary\",\"#ffb597\"],[\"tertiary_container\",\"#79746e\"],[\"surface_container_low\",\"#f6f3f0\"],[\"primary\",\"#8c4a2d\"],[\"on_primary\",\"#ffffff\"],[\"surface_container_high\",\"#eae8e5\"],[\"on_surface_variant\",\"#53433d\"],[\"inverse_surface\",\"#31302f\"],[\"secondary_container\",\"#e9ddd7\"],[\"clay-dark\",\"#A85E40\"],[\"surface_tint\",\"#8f4c2f\"],[\"surface\",\"#fcf9f6\"],[\"on_secondary_fixed_variant\",\"#4d4541\"],[\"on_tertiary_fixed\",\"#1e1b17\"],[\"ink-light\",\"#5A4E48\"],[\"primary_fixed_dim\",\"#ffb597\"],[\"on_error\",\"#ffffff\"],[\"on_secondary_fixed\",\"#201a17\"],[\"on_secondary\",\"#ffffff\"],[\"tertiary\",\"#605b56\"],[\"border-subtle\",\"#E8DDD6\"],[\"on_primary_container\",\"#fffbff\"],[\"surface_container_lowest\",\"#ffffff\"],[\"on_primary_fixed_variant\",\"#72351a\"],[\"background\",\"#fcf9f6\"],[\"on_primary_fixed\",\"#360f00\"],[\"primary_container\",\"#aa6243\"],[\"surface_bright\",\"#fcf9f6\"]],\"---\\nname: Stitch Design System\\ncolors:\\n  surface: '#fcf9f6'\\n  surface-dim: '#dcdad7'\\n  surface-bright: '#fcf9f6'\\n  surface-container-lowest: '#ffffff'\\n  surface-container-low: '#f6f3f0'\\n  surface-container: '#f0edea'\\n  surface-container-high: '#eae8e5'\\n  surface-container-highest: '#e5e2df'\\n  on-surface: '#1c1c1a'\\n  on-surface-variant: '#53433d'\\n  inverse-surface: '#31302f'\\n  inverse-on-surface: '#f3f0ed'\\n  outline: '#86736c'\\n  outline-variant: '#d9c2b9'\\n  surface-tint: '#8f4c2f'\\n  primary: '#8c4a2d'\\n  on-primary: '#ffffff'\\n  primary-container: '#aa6243'\\n  on-primary-container: '#fffbff'\\n  inverse-primary: '#ffb597'\\n  secondary: '#655d58'\\n  on-secondary: '#ffffff'\\n  secondary-container: '#e9ddd7'\\n  on-secondary-container: '#69615c'\\n  tertiary: '#605b56'\\n  on-tertiary: '#ffffff'\\n  tertiary-container: '#79746e'\\n  on-tertiary-container: '#fffbff'\\n  error: '#ba1a1a'\\n  on-error: '#ffffff'\\n  error-container: '#ffdad6'\\n  on-error-container: '#93000a'\\n  primary-fixed: '#ffdbcd'\\n  primary-fixed-dim: '#ffb597'\\n  on-primary-fixed: '#360f00'\\n  on-primary-fixed-variant: '#72351a'\\n  secondary-fixed: '#ece0da'\\n  secondary-fixed-dim: '#cfc4be'\\n  on-secondary-fixed: '#201a17'\\n  on-secondary-fixed-variant: '#4d4541'\\n  tertiary-fixed: '#e9e1da'\\n  tertiary-fixed-dim: '#ccc5bf'\\n  on-tertiary-fixed: '#1e1b17'\\n  on-tertiary-fixed-variant: '#4a4641'\\n  background: '#fcf9f6'\\n  on-background: '#1c1c1a'\\n  surface-variant: '#e5e2df'\\n  clay-dark: '#A85E40'\\n  ink-light: '#5A4E48'\\n  sage: '#D6E4D8'\\n  cream-warm: '#F2ECE6'\\n  border-subtle: '#E8DDD6'\\ntypography:\\n  display:\\n    fontFamily: DM Serif Display\\n    fontSize: 80px\\n    fontWeight: '400'\\n    lineHeight: '1.1'\\n    letterSpacing: -0.02em\\n  display-mobile:\\n    fontFamily: DM Serif Display\\n    fontSize: 44px\\n    fontWeight: '400'\\n    lineHeight: '1.2'\\n  headline-lg:\\n    fontFamily: DM Serif Display\\n    fontSize: 40px\\n    fontWeight: '400'\\n    lineHeight: '1.3'\\n  headline-md:\\n    fontFamily: DM Serif Display\\n    fontSize: 32px\\n    fontWeight: '400'\\n    lineHeight: '1.3'\\n  body-lg:\\n    fontFamily: DM Sans\\n    fontSize: 16px\\n    fontWeight: '400'\\n    lineHeight: '1.8'\\n    letterSpacing: 0.01em\\n  body-md:\\n    fontFamily: DM Sans\\n    fontSize: 14px\\n    fontWeight: '400'\\n    lineHeight: '1.85'\\n  label-uppercase:\\n    fontFamily: DM Sans\\n    fontSize: 12px\\n    fontWeight: '500'\\n    lineHeight: '1.2'\\n    letterSpacing: 0.15em\\n  caption:\\n    fontFamily: DM Sans\\n    fontSize: 11px\\n    fontWeight: '500'\\n    lineHeight: '1.4'\\n    letterSpacing: 0.05em\\nrounded:\\n  sm: 0.25rem\\n  DEFAULT: 0.5rem\\n  md: 0.75rem\\n  lg: 1rem\\n  xl: 1.5rem\\n  full: 9999px\\nspacing:\\n  container-max: 1440px\\n  section-gap-desktop: 80px\\n  section-gap-mobile: 48px\\n  grid-gutter: 24px\\n  element-gap-sm: 8px\\n  element-gap-md: 16px\\n  element-gap-lg: 32px\\n---\\n\\n## Brand \\u0026 Style\\n\\nThe brand identity centers on **Ethical Luxury**—a harmony between artisanal craftsmanship and sustainable consciousness. It targets a discerning audience that values \\\"Quiet Luxury,\\\" where quality is felt through texture and space rather than loud logos.\\n\\nThe design style is **Refined Minimalism**. It leverages heavy whitespace to create \\\"breathing room,\\\" allowing high-quality imagery and sophisticated typography to take center stage. The aesthetic is warm and organic, moving away from cold, clinical minimalism toward a more tactile, human-centric experience. Visual interest is generated through:\\n- **Sophisticated Layering:** Using background color shifts and subtle blurs rather than heavy shadows.\\n- **Organic Geometry:** A mix of large-radius containers and pill-shaped interactive elements.\\n- **Editorial Polish:** High-contrast typography that mirrors premium print magazines.\\n\\n## Colors\\n\\nThe palette is inspired by natural, undyed fibers and earthen materials. \\n\\n- **Primary (Clay):** Used for call-to-actions, price accents, and critical indicators. It provides a warm, energetic contrast to the neutral base.\\n- **Secondary (Ink):** The foundation for readability. Used for all primary headings and body text to ensure high legibility against light backgrounds.\\n- **Tertiary (Blush):** A soft accent for secondary surfaces, card backgrounds, and promotional banners.\\n- **Neutral (Cream):** The primary canvas. This off-white base reduces eye strain and feels more premium and \\\"organic\\\" than pure white.\\n- **Named Colors:** **Sage** is reserved for eco-specific callouts or decorative elements to reinforce the sustainability narrative. **Ink-light** is used for secondary navigation and metadata to create visual hierarchy.\\n\\n## Typography\\n\\nThis design system employs a high-contrast pairing to balance heritage and modernity.\\n\\n- **Headlines:** Use **DM Serif Display**. Its graceful curves and high contrast evoke luxury and editorial authority. Use it sparingly for section headers and hero statements.\\n- **Body \\u0026 UI:** Use **DM Sans**. This low-contrast geometric sans-serif ensures maximum legibility across all digital interfaces. \\n- **The \\\"Label-Uppercase\\\" Style:** This is a signature brand element. Use it for navigation, small headings over titles, and button labels. The generous letter-spacing (tracking) is essential to achieving the \\\"premium\\\" feel.\\n- **Line Height:** Maintain a generous line height (1.8 - 1.85) for body text to reinforce the airy, spacious aesthetic.\\n\\n## Layout \\u0026 Spacing\\n\\nThe layout philosophy follows a **Fluid Grid** model with extreme emphasis on vertical breathing room.\\n\\n- **Grid:** Use a 12-column grid for desktop and a 2-column grid for mobile. \\n- **Margins:** Desktop margins should be at least 64px to create a \\\"framed\\\" editorial look. Mobile margins should be 20px.\\n- **Vertical Spacing:** Use `section-gap-desktop` (80px) between major content blocks. This intentional \\\"over-spacing\\\" is what differentiates the design from standard e-commerce layouts.\\n- **Alignment:** Center-align hero content and primary section titles to maintain a formal, balanced feel. Use left-alignment for product grids and content-heavy blocks.\\n\\n## Elevation \\u0026 Depth\\n\\nThis design system avoids heavy drop shadows in favor of **Tonal Layering** and **Atmospheric Depth**.\\n\\n- **Surface Tiers:** Depth is indicated by shifting background colors (e.g., a `Blush` card on a `Cream` background).\\n- **Glassmorphism:** Use `backdrop-blur` (8px to 12px) for sticky headers and floating badges. This creates a sense of lightness and transparency.\\n- **Subtle Elevation:** For interactive states (like hover on product cards), use a very soft, low-opacity shadow: `0 10px 30px rgba(42, 36, 32, 0.05)`. The shadow should feel like a soft ambient light rather than a hard edge.\\n- **Transitions:** All elevation changes should be paired with a subtle vertical translation (e.g., `translateY(-4px)`) to provide tactile feedback.\\n\\n## Shapes\\n\\nThe shape language is \\\"Soft-Modern,\\\" utilizing rounded corners to evoke friendliness and comfort—qualities essential to a wearable fashion brand.\\n\\n- **Small Elements (Buttons, Tags, Pills):** Use `rounded-full` (pill-shaped). This creates a distinct interactive language that feels modern and approachable.\\n- **Medium Elements (Product Images, Floating Cards):** Use `rounded-lg` (1rem / 16px). This softens the grid without making it feel juvenile.\\n- **Large Elements (Banners, Testimonial Containers):** Use `rounded-xl` (1.5rem / 24px) to create \\\"enveloping\\\" containers that feel substantial and high-end.\\n\\n## Components\\n\\n### Buttons\\n- **Primary:** Pill-shaped, `Clay` background, white text, `label-uppercase` typography. \\n- **Secondary:** Pill-shaped, `Ink` border (1px), `Ink` text. Hover state fills the background with `Ink` and changes text to `Cream`.\\n- **Ghost:** No border, `label-uppercase` text with a subtle underline that expands on hover.\\n\\n### Input Fields\\n- **Style:** Underlined or very soft borders (`border-subtle`). \\n- **Focus State:** Border color shifts to `Clay`.\\n- **Typography:** Placeholder text in `Ink-light` using `body-md`.\\n\\n### Cards\\n- **Product Cards:** No visible borders. Imagery uses `rounded-lg`. Product name and price are stacked below with `element-gap-sm`. On hover, the image should subtly scale or lift.\\n- **Testimonial/Category Cards:** Use `Blush` or `Sage` backgrounds with `rounded-xl`. \\n\\n### Chips \\u0026 Filters\\n- **Style:** Always pill-shaped (`rounded-full`). \\n- **Active State:** `Clay` background with white text.\\n- **Inactive State:** `Cream-warm` background or 1px `border-subtle`.\\n\\n### Navigation\\n- **Header:** Sticky with `backdrop-blur` and a `Cream` background at 90% opacity. \\n- **Links:** Use `label-uppercase` with 24px horizontal spacing. An active state is indicated by a thin 1px underline.\",6,\"#c97b5a\",\"#2a2420\",\"#f5ede6\",\"#faf7f4\",2,[[\"headline-lg\",[\"DM Serif Display\",\"40px\",\"400\",\"1.3\"]],[\"headline-md\",[\"DM Serif Display\",\"32px\",\"400\",\"1.3\"]],[\"caption\",[\"DM Sans\",\"11px\",\"500\",\"1.4\",\"0.05em\"]],[\"body-lg\",[\"DM Sans\",\"16px\",\"400\",\"1.8\",\"0.01em\"]],[\"body-md\",[\"DM Sans\",\"14px\",\"400\",\"1.85\"]],[\"display\",[\"DM Serif Display\",\"80px\",\"400\",\"1.1\",\"-0.02em\"]],[\"display-mobile\",[\"DM Serif Display\",\"44px\",\"400\",\"1.2\"]],[\"label-uppercase\",[\"DM Sans\",\"12px\",\"500\",\"1.2\",\"0.15em\"]]],[[\"element-gap-md\",\"16px\"],[\"element-gap-lg\",\"32px\"],[\"grid-gutter\",\"24px\"],[\"section-gap-desktop\",\"80px\"],[\"container-max\",\"1440px\"],[\"section-gap-mobile\",\"48px\"],[\"element-gap-sm\",\"8px\"]],null,\"dmSerifDisplay\",\"Dm Sans\",\"Dm Sans\"],2,1,null,[null,2,null,null,2],null,null,[\"assets/f84726af88af499598b78556bda4af11\",null,[\"Stitch Design System\",null,\"## Brand \\u0026 Style\\n\\nThe brand identity centers on **Ethical Luxury**—a harmony between artisanal craftsmanship and sustainable consciousness. It targets a discerning audience that values \\\"Quiet Luxury,\\\" where quality is felt through texture and space rather than loud logos.\\n\\nThe design style is **Refined Minimalism**. It leverages heavy whitespace to create \\\"breathing room,\\\" allowing high-quality imagery and sophisticated typography to take center stage. The aesthetic is warm and organic, moving away from cold, clinical minimalism toward a more tactile, human-centric experience. Visual interest is generated through:\\n- **Sophisticated Layering:** Using background color shifts and subtle blurs rather than heavy shadows.\\n- **Organic Geometry:** A mix of large-radius containers and pill-shaped interactive elements.\\n- **Editorial Polish:** High-contrast typography that mirrors premium print magazines.\\n\\n## Layout \\u0026 Spacing\\n\\nThe layout philosophy follows a **Fluid Grid** model with extreme emphasis on vertical breathing room.\\n\\n- **Grid:** Use a 12-column grid for desktop and a 2-column grid for mobile. \\n- **Margins:** Desktop margins should be at least 64px to create a \\\"framed\\\" editorial look. Mobile margins should be 20px.\\n- **Vertical Spacing:** Use `section-gap-desktop` (80px) between major content blocks. This intentional \\\"over-spacing\\\" is what differentiates the design from standard e-commerce layouts.\\n- **Alignment:** Center-align hero content and primary section titles to maintain a formal, balanced feel. Use left-alignment for product grids and content-heavy blocks.\\n\\n## Elevation \\u0026 Depth\\n\\nThis design system avoids heavy drop shadows in favor of **Tonal Layering** and **Atmospheric Depth**.\\n\\n- **Surface Tiers:** Depth is indicated by shifting background colors (e.g., a `Blush` card on a `Cream` background).\\n- **Glassmorphism:** Use `backdrop-blur` (8px to 12px) for sticky headers and floating badges. This creates a sense of lightness and transparency.\\n- **Subtle Elevation:** For interactive states (like hover on product cards), use a very soft, low-opacity shadow: `0 10px 30px rgba(42, 36, 32, 0.05)`. The shadow should feel like a soft ambient light rather than a hard edge.\\n- **Transitions:** All elevation changes should be paired with a subtle vertical translation (e.g., `translateY(-4px)`) to provide tactile feedback.\\n\\n## Components\\n\\n### Buttons\\n- **Primary:** Pill-shaped, `Clay` background, white text, `label-uppercase` typography. \\n- **Secondary:** Pill-shaped, `Ink` border (1px), `Ink` text. Hover state fills the background with `Ink` and changes text to `Cream`.\\n- **Ghost:** No border, `label-uppercase` text with a subtle underline that expands on hover.\\n\\n### Input Fields\\n- **Style:** Underlined or very soft borders (`border-subtle`). \\n- **Focus State:** Border color shifts to `Clay`.\\n- **Typography:** Placeholder text in `Ink-light` using `body-md`.\\n\\n### Cards\\n- **Product Cards:** No visible borders. Imagery uses `rounded-lg`. Product name and price are stacked below with `element-gap-sm`. On hover, the image should subtly scale or lift.\\n- **Testimonial/Category Cards:** Use `Blush` or `Sage` backgrounds with `rounded-xl`. \\n\\n### Chips \\u0026 Filters\\n- **Style:** Always pill-shaped (`rounded-full`). \\n- **Active State:** `Clay` background with white text.\\n- **Inactive State:** `Cream-warm` background or 1px `border-subtle`.\\n\\n### Navigation\\n- **Header:** Sticky with `backdrop-blur` and a `Cream` background at 90% opacity. \\n- **Links:** Use `label-uppercase` with 24px horizontal spacing. An active state is indicated by a thin 1px underline.\",[1,null,3,null,\"#c97b5a\",null,null,null,null,null,26,26,[[\"primary_fixed_dim\",\"#ffb597\"],[\"on_error\",\"#ffffff\"],[\"ink-light\",\"#5A4E48\"],[\"on_tertiary_fixed\",\"#1e1b17\"],[\"surface\",\"#fcf9f6\"],[\"surface_tint\",\"#8f4c2f\"],[\"on_secondary_fixed_variant\",\"#4d4541\"],[\"surface_bright\",\"#fcf9f6\"],[\"primary_container\",\"#aa6243\"],[\"on_primary_fixed\",\"#360f00\"],[\"surface_container_lowest\",\"#ffffff\"],[\"on_primary_container\",\"#fffbff\"],[\"on_primary_fixed_variant\",\"#72351a\"],[\"background\",\"#fcf9f6\"],[\"on_secondary\",\"#ffffff\"],[\"on_secondary_fixed\",\"#201a17\"],[\"tertiary\",\"#605b56\"],[\"border-subtle\",\"#E8DDD6\"],[\"on_primary\",\"#ffffff\"],[\"primary\",\"#8c4a2d\"],[\"surface_container_low\",\"#f6f3f0\"],[\"tertiary_container\",\"#79746e\"],[\"inverse_primary\",\"#ffb597\"],[\"clay-dark\",\"#A85E40\"],[\"surface_container_high\",\"#eae8e5\"],[\"on_surface_variant\",\"#53433d\"],[\"inverse_surface\",\"#31302f\"],[\"secondary_container\",\"#e9ddd7\"],[\"surface_container\",\"#f0edea\"],[\"error\",\"#ba1a1a\"],[\"primary_fixed\",\"#ffdbcd\"],[\"outline_variant\",\"#d9c2b9\"],[\"surface_variant\",\"#e5e2df\"],[\"on_tertiary_fixed_variant\",\"#4a4641\"],[\"tertiary_fixed_dim\",\"#ccc5bf\"],[\"tertiary_fixed\",\"#e9e1da\"],[\"outline\",\"#86736c\"],[\"on_background\",\"#1c1c1a\"],[\"secondary_fixed_dim\",\"#cfc4be\"],[\"error_container\",\"#ffdad6\"],[\"secondary_fixed\",\"#ece0da\"],[\"on_secondary_container\",\"#69615c\"],[\"on_error_container\",\"#93000a\"],[\"secondary\",\"#655d58\"],[\"inverse_on_surface\",\"#f3f0ed\"],[\"on_tertiary\",\"#ffffff\"],[\"surface_container_highest\",\"#e5e2df\"],[\"sage\",\"#D6E4D8\"],[\"on_tertiary_container\",\"#fffbff\"],[\"surface_dim\",\"#dcdad7\"],[\"cream-warm\",\"#F2ECE6\"],[\"on_surface\",\"#1c1c1a\"]],\"---\\nname: Stitch Design System\\ncolors:\\n  surface: '#fcf9f6'\\n  surface-dim: '#dcdad7'\\n  surface-bright: '#fcf9f6'\\n  surface-container-lowest: '#ffffff'\\n  surface-container-low: '#f6f3f0'\\n  surface-container: '#f0edea'\\n  surface-container-high: '#eae8e5'\\n  surface-container-highest: '#e5e2df'\\n  on-surface: '#1c1c1a'\\n  on-surface-variant: '#53433d'\\n  inverse-surface: '#31302f'\\n  inverse-on-surface: '#f3f0ed'\\n  outline: '#86736c'\\n  outline-variant: '#d9c2b9'\\n  surface-tint: '#8f4c2f'\\n  primary: '#8c4a2d'\\n  on-primary: '#ffffff'\\n  primary-container: '#aa6243'\\n  on-primary-container: '#fffbff'\\n  inverse-primary: '#ffb597'\\n  secondary: '#655d58'\\n  on-secondary: '#ffffff'\\n  secondary-container: '#e9ddd7'\\n  on-secondary-container: '#69615c'\\n  tertiary: '#605b56'\\n  on-tertiary: '#ffffff'\\n  tertiary-container: '#79746e'\\n  on-tertiary-container: '#fffbff'\\n  error: '#ba1a1a'\\n  on-error: '#ffffff'\\n  error-container: '#ffdad6'\\n  on-error-container: '#93000a'\\n  primary-fixed: '#ffdbcd'\\n  primary-fixed-dim: '#ffb597'\\n  on-primary-fixed: '#360f00'\\n  on-primary-fixed-variant: '#72351a'\\n  secondary-fixed: '#ece0da'\\n  secondary-fixed-dim: '#cfc4be'\\n  on-secondary-fixed: '#201a17'\\n  on-secondary-fixed-variant: '#4d4541'\\n  tertiary-fixed: '#e9e1da'\\n  tertiary-fixed-dim: '#ccc5bf'\\n  on-tertiary-fixed: '#1e1b17'\\n  on-tertiary-fixed-variant: '#4a4641'\\n  background: '#fcf9f6'\\n  on-background: '#1c1c1a'\\n  surface-variant: '#e5e2df'\\n  clay-dark: '#A85E40'\\n  ink-light: '#5A4E48'\\n  sage: '#D6E4D8'\\n  cream-warm: '#F2ECE6'\\n  border-subtle: '#E8DDD6'\\ntypography:\\n  display:\\n    fontFamily: DM Serif Display\\n    fontSize: 80px\\n    fontWeight: '400'\\n    lineHeight: '1.1'\\n    letterSpacing: -0.02em\\n  display-mobile:\\n    fontFamily: DM Serif Display\\n    fontSize: 44px\\n    fontWeight: '400'\\n    lineHeight: '1.2'\\n  headline-lg:\\n    fontFamily: DM Serif Display\\n    fontSize: 40px\\n    fontWeight: '400'\\n    lineHeight: '1.3'\\n  headline-md:\\n    fontFamily: DM Serif Display\\n    fontSize: 32px\\n    fontWeight: '400'\\n    lineHeight: '1.3'\\n  body-lg:\\n    fontFamily: DM Sans\\n    fontSize: 16px\\n    fontWeight: '400'\\n    lineHeight: '1.8'\\n    letterSpacing: 0.01em\\n  body-md:\\n    fontFamily: DM Sans\\n    fontSize: 14px\\n    fontWeight: '400'\\n    lineHeight: '1.85'\\n  label-uppercase:\\n    fontFamily: DM Sans\\n    fontSize: 12px\\n    fontWeight: '500'\\n    lineHeight: '1.2'\\n    letterSpacing: 0.15em\\n  caption:\\n    fontFamily: DM Sans\\n    fontSize: 11px\\n    fontWeight: '500'\\n    lineHeight: '1.4'\\n    letterSpacing: 0.05em\\nrounded:\\n  sm: 0.25rem\\n  DEFAULT: 0.5rem\\n  md: 0.75rem\\n  lg: 1rem\\n  xl: 1.5rem\\n  full: 9999px\\nspacing:\\n  container-max: 1440px\\n  section-gap-desktop: 80px\\n  section-gap-mobile: 48px\\n  grid-gutter: 24px\\n  element-gap-sm: 8px\\n  element-gap-md: 16px\\n  element-gap-lg: 32px\\n---\\n\\n## Brand \\u0026 Style\\n\\nThe brand identity centers on **Ethical Luxury**—a harmony between artisanal craftsmanship and sustainable consciousness. It targets a discerning audience that values \\\"Quiet Luxury,\\\" where quality is felt through texture and space rather than loud logos.\\n\\nThe design style is **Refined Minimalism**. It leverages heavy whitespace to create \\\"breathing room,\\\" allowing high-quality imagery and sophisticated typography to take center stage. The aesthetic is warm and organic, moving away from cold, clinical minimalism toward a more tactile, human-centric experience. Visual interest is generated through:\\n- **Sophisticated Layering:** Using background color shifts and subtle blurs rather than heavy shadows.\\n- **Organic Geometry:** A mix of large-radius containers and pill-shaped interactive elements.\\n- **Editorial Polish:** High-contrast typography that mirrors premium print magazines.\\n\\n## Colors\\n\\nThe palette is inspired by natural, undyed fibers and earthen materials. \\n\\n- **Primary (Clay):** Used for call-to-actions, price accents, and critical indicators. It provides a warm, energetic contrast to the neutral base.\\n- **Secondary (Ink):** The foundation for readability. Used for all primary headings and body text to ensure high legibility against light backgrounds.\\n- **Tertiary (Blush):** A soft accent for secondary surfaces, card backgrounds, and promotional banners.\\n- **Neutral (Cream):** The primary canvas. This off-white base reduces eye strain and feels more premium and \\\"organic\\\" than pure white.\\n- **Named Colors:** **Sage** is reserved for eco-specific callouts or decorative elements to reinforce the sustainability narrative. **Ink-light** is used for secondary navigation and metadata to create visual hierarchy.\\n\\n## Typography\\n\\nThis design system employs a high-contrast pairing to balance heritage and modernity.\\n\\n- **Headlines:** Use **DM Serif Display**. Its graceful curves and high contrast evoke luxury and editorial authority. Use it sparingly for section headers and hero statements.\\n- **Body \\u0026 UI:** Use **DM Sans**. This low-contrast geometric sans-serif ensures maximum legibility across all digital interfaces. \\n- **The \\\"Label-Uppercase\\\" Style:** This is a signature brand element. Use it for navigation, small headings over titles, and button labels. The generous letter-spacing (tracking) is essential to achieving the \\\"premium\\\" feel.\\n- **Line Height:** Maintain a generous line height (1.8 - 1.85) for body text to reinforce the airy, spacious aesthetic.\\n\\n## Layout \\u0026 Spacing\\n\\nThe layout philosophy follows a **Fluid Grid** model with extreme emphasis on vertical breathing room.\\n\\n- **Grid:** Use a 12-column grid for desktop and a 2-column grid for mobile. \\n- **Margins:** Desktop margins should be at least 64px to create a \\\"framed\\\" editorial look. Mobile margins should be 20px.\\n- **Vertical Spacing:** Use `section-gap-desktop` (80px) between major content blocks. This intentional \\\"over-spacing\\\" is what differentiates the design from standard e-commerce layouts.\\n- **Alignment:** Center-align hero content and primary section titles to maintain a formal, balanced feel. Use left-alignment for product grids and content-heavy blocks.\\n\\n## Elevation \\u0026 Depth\\n\\nThis design system avoids heavy drop shadows in favor of **Tonal Layering** and **Atmospheric Depth**.\\n\\n- **Surface Tiers:** Depth is indicated by shifting background colors (e.g., a `Blush` card on a `Cream` background).\\n- **Glassmorphism:** Use `backdrop-blur` (8px to 12px) for sticky headers and floating badges. This creates a sense of lightness and transparency.\\n- **Subtle Elevation:** For interactive states (like hover on product cards), use a very soft, low-opacity shadow: `0 10px 30px rgba(42, 36, 32, 0.05)`. The shadow should feel like a soft ambient light rather than a hard edge.\\n- **Transitions:** All elevation changes should be paired with a subtle vertical translation (e.g., `translateY(-4px)`) to provide tactile feedback.\\n\\n## Shapes\\n\\nThe shape language is \\\"Soft-Modern,\\\" utilizing rounded corners to evoke friendliness and comfort—qualities essential to a wearable fashion brand.\\n\\n- **Small Elements (Buttons, Tags, Pills):** Use `rounded-full` (pill-shaped). This creates a distinct interactive language that feels modern and approachable.\\n- **Medium Elements (Product Images, Floating Cards):** Use `rounded-lg` (1rem / 16px). This softens the grid without making it feel juvenile.\\n- **Large Elements (Banners, Testimonial Containers):** Use `rounded-xl` (1.5rem / 24px) to create \\\"enveloping\\\" containers that feel substantial and high-end.\\n\\n## Components\\n\\n### Buttons\\n- **Primary:** Pill-shaped, `Clay` background, white text, `label-uppercase` typography. \\n- **Secondary:** Pill-shaped, `Ink` border (1px), `Ink` text. Hover state fills the background with `Ink` and changes text to `Cream`.\\n- **Ghost:** No border, `label-uppercase` text with a subtle underline that expands on hover.\\n\\n### Input Fields\\n- **Style:** Underlined or very soft borders (`border-subtle`). \\n- **Focus State:** Border color shifts to `Clay`.\\n- **Typography:** Placeholder text in `Ink-light` using `body-md`.\\n\\n### Cards\\n- **Product Cards:** No visible borders. Imagery uses `rounded-lg`. Product name and price are stacked below with `element-gap-sm`. On hover, the image should subtly scale or lift.\\n- **Testimonial/Category Cards:** Use `Blush` or `Sage` backgrounds with `rounded-xl`. \\n\\n### Chips \\u0026 Filters\\n- **Style:** Always pill-shaped (`rounded-full`). \\n- **Active State:** `Clay` background with white text.\\n- **Inactive State:** `Cream-warm` background or 1px `border-subtle`.\\n\\n### Navigation\\n- **Header:** Sticky with `backdrop-blur` and a `Cream` background at 90% opacity. \\n- **Links:** Use `label-uppercase` with 24px horizontal spacing. An active state is indicated by a thin 1px underline.\",6,\"#c97b5a\",\"#2a2420\",\"#f5ede6\",\"#faf7f4\",2,[[\"caption\",[\"DM Sans\",\"11px\",\"500\",\"1.4\",\"0.05em\"]],[\"headline-lg\",[\"DM Serif Display\",\"40px\",\"400\",\"1.3\"]],[\"headline-md\",[\"DM Serif Display\",\"32px\",\"400\",\"1.3\"]],[\"display-mobile\",[\"DM Serif Display\",\"44px\",\"400\",\"1.2\"]],[\"label-uppercase\",[\"DM Sans\",\"12px\",\"500\",\"1.2\",\"0.15em\"]],[\"body-lg\",[\"DM Sans\",\"16px\",\"400\",\"1.8\",\"0.01em\"]],[\"display\",[\"DM Serif Display\",\"80px\",\"400\",\"1.1\",\"-0.02em\"]],[\"body-md\",[\"DM Sans\",\"14px\",\"400\",\"1.85\"]]],[[\"element-gap-md\",\"16px\"],[\"section-gap-mobile\",\"48px\"],[\"element-gap-sm\",\"8px\"],[\"container-max\",\"1440px\"],[\"element-gap-lg\",\"32px\"],[\"grid-gutter\",\"24px\"],[\"section-gap-desktop\",\"80px\"]],null,\"dmSerifDisplay\",\"Dm Sans\",\"Dm Sans\"]],1]],[[\"projects/18178749605532028059/files/f37be54fa3ea40599ba55093c273b902\",null,\"https://lh3.googleusercontent.com/aida/AP1WRLv0eVt1WFiKprsVJS5fVy2aEJGRkCCZutUNIkxoCVoZ7U-qjgw49SP8Iu-CwpbbD6GbyFOQUd6cHkpUT22DUU3KTMN6o-YiETKxsZ-0e2c5kjEZU6GtYTl0kGMEgO3ha0BRGB5iwF1_DUwpxfGpyAM1eGxM8uQXAnshHpCkH40po9oBQONosqXKu1Q-Fv7MMqqltWOYyHFX7igKyiCmcgFZNfcbLifHHoJuMZD7YwxMEm_aPd4BNQKEfUSc\"],null,null,null,\"7abe7cc1a3e74e38bfcc99f9cc0c8701\",\"interactive_ui_controller\",\"896\",\"1200\",\"Eco-friendly boys' clothing: a pair of durable denim overalls made from recycled cotton, simple design, soft focus background, professional fashion photography, sustainable kids fashion.\",\"Eco-friendly boys' clothing: a pair of durable denim overalls made from recycled cotton, simple design, soft focus background, professional fashion photography, sustainable kids fashion.\",\"projects/18178749605532028059/screens/7abe7cc1a3e74e38bfcc99f9cc0c8701\",[],null,2,null,[null,2,null,nul