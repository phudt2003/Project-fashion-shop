)]}'

[["wrb.fr","eW2RYb","[\"projects/18178749605532028059\",\"Design Fashion Shop\",1,[1781074247,724018000],[1781883392,254876000],4,[\"projects/18178749605532028059/files/5a9ac45e15f5484a9c9e3c5d3f3af472\",null,\"https://lh3.googleusercontent.com/aida/AP1WRLsmm1vAQefgmd9sQEwfa2bhPW8faOs602zqgIAGuaGEMQvLdBKiKzNgfMq6Wq2lg46-OSoaVuc55GufVXOuY39oFVvknrGFvHphQ7dFVaQRSVSqv6_BM-xco5v75rSreL-RGtX0I_R6LMDHmotNIHEJCNY-M7yDK8M3uR1_EEZ-5raK0h1KiO4X1Ris8WKPZAyC0HV4ll4Qvg00Qm59KrHYNwo22-H89eX9s9MhhfIWaJjLmfRQcGfB_SUk\"],1,2,[1,null,3,null,\"#c97b5a\",null,null,null,null,null,26,26,[[\"primary\",\"#8c4a2d\"],[\"inverse_on_surface\",\"#f3f0ed\"],[\"on_error_container\",\"#93000a\"],[\"on_secondary_fixed\",\"#201a17\"],[\"on_background\",\"#1c1c1a\"],[\"sage\",\"#D6E4D8\"],[\"on_surface_variant\",\"#53433d\"],[\"inverse_primary\",\"#ffb597\"],[\"on_primary_container\",\"#fffbff\"],[\"on_primary\",\"#ffffff\"],[\"surface_container\",\"#f0edea\"],[\"surface_dim\",\"#dcdad7\"],[\"outline\",\"#86736c\"],[\"primary_fixed\",\"#ffdbcd\"],[\"cream-warm\",\"#F2ECE6\"],[\"on_primary_fixed\",\"#360f00\"],[\"on_tertiary_container\",\"#fffbff\"],[\"surface_container_lowest\",\"#ffffff\"],[\"border-subtle\",\"#E8DDD6\"],[\"surface_variant\",\"#e5e2df\"],[\"on_surface\",\"#1c1c1a\"],[\"ink-light\",\"#5A4E48\"],[\"on_primary_fixed_variant\",\"#72351a\"],[\"secondary_fixed_dim\",\"#cfc4be\"],[\"primary_container\",\"#aa6243\"],[\"tertiary_fixed_dim\",\"#ccc5bf\"],[\"on_tertiary\",\"#ffffff\"],[\"surface_container_low\",\"#f6f3f0\"],[\"error\",\"#ba1a1a\"],[\"on_tertiary_fixed\",\"#1e1b17\"],[\"clay-dark\",\"#A85E40\"],[\"on_tertiary_fixed_variant\",\"#4a4641\"],[\"secondary_container\",\"#e9ddd7\"],[\"surface_tint\",\"#8f4c2f\"],[\"background\",\"#fcf9f6\"],[\"on_error\",\"#ffffff\"],[\"on_secondary_fixed_variant\",\"#4d4541\"],[\"surface_container_highest\",\"#e5e2df\"],[\"outline_variant\",\"#d9c2b9\"],[\"inverse_surface\",\"#31302f\"],[\"error_container\",\"#ffdad6\"],[\"tertiary_fixed\",\"#e9e1da\"],[\"on_secondary\",\"#ffffff\"],[\"secondary\",\"#655d58\"],[\"secondary_fixed\",\"#ece0da\"],[\"tertiary\",\"#605b56\"],[\"surface_container_high\",\"#eae8e5\"],[\"surface_bright\",\"#fcf9f6\"],[\"surface\",\"#fcf9f6\"],[\"tertiary_container\",\"#79746e\"],[\"primary_fixed_dim\",\"#ffb597\"],[\"on_secondary_container\",\"#69615c\"]],\"---\\nname: Stitch Design System\\ncolors:\\n  surface: '#fcf9f6'\\n  surface-dim: '#dcdad7'\\n  surface-bright: '#fcf9f6'\\n  surface-container-lowest: '#ffffff'\\n  surface-container-low: '#f6f3f0'\\n  surface-container: '#f0edea'\\n  surface-container-high: '#eae8e5'\\n  surface-container-highest: '#e5e2df'\\n  on-surface: '#1c1c1a'\\n  on-surface-variant: '#53433d'\\n  inverse-surface: '#31302f'\\n  inverse-on-surface: '#f3f0ed'\\n  outline: '#86736c'\\n  outline-variant: '#d9c2b9'\\n  surface-tint: '#8f4c2f'\\n  primary: '#8c4a2d'\\n  on-primary: '#ffffff'\\n  primary-container: '#aa6243'\\n  on-primary-container: '#fffbff'\\n  inverse-primary: '#ffb597'\\n  secondary: '#655d58'\\n  on-secondary: '#ffffff'\\n  secondary-container: '#e9ddd7'\\n  on-secondary-container: '#69615c'\\n  tertiary: '#605b56'\\n  on-tertiary: '#ffffff'\\n  tertiary-container: '#79746e'\\n  on-tertiary-container: '#fffbff'\\n  error: '#ba1a1a'\\n  on-error: '#ffffff'\\n  error-container: '#ffdad6'\\n  on-error-container: '#93000a'\\n  primary-fixed: '#ffdbcd'\\n  primary-fixed-dim: '#ffb597'\\n  on-primary-fixed: '#360f00'\\n  on-primary-fixed-variant: '#72351a'\\n  secondary-fixed: '#ece0da'\\n  secondary-fixed-dim: '#cfc4be'\\n  on-secondary-fixed: '#201a17'\\n  on-secondary-fixed-variant: '#4d4541'\\n  tertiary-fixed: '#e9e1da'\\n  tertiary-fixed-dim: '#ccc5bf'\\n  on-tertiary-fixed: '#1e1b17'\\n  on-tertiary-fixed-variant: '#4a4641'\\n  background: '#fcf9f6'\\n  on-background: '#1c1c1a'\\n  surface-variant: '#e5e2df'\\n  clay-dark: '#A85E40'\\n  ink-light: '#5A4E48'\\n  sage: '#D6E4D8'\\n  cream-warm: '#F2ECE6'\\n  border-subtle: '#E8DDD6'\\ntypography:\\n  display:\\n    fontFamily: DM Serif Display\\n    fontSize: 80px\\n    fontWeight: '400'\\n    lineHeight: '1.1'\\n    letterSpacing: -0.02em\\n  display-mobile:\\n    fontFamily: DM Serif Display\\n    fontSize: 44px\\n    fontWeight: '400'\\n    lineHeight: '1.2'\\n  headline-lg:\\n    fontFamily: DM Serif Display\\n    fontSize: 40px\\n    fontWeight: '400'\\n    lineHeight: '1.3'\\n  headline-md:\\n    fontFamily: DM Serif Display\\n    fontSize: 32px\\n    fontWeight: '400'\\n    lineHeight: '1.3'\\n  body-lg:\\n    fontFamily: DM Sans\\n    fontSize: 16px\\n    fontWeight: '400'\\n    lineHeight: '1.8'\\n    letterSpacing: 0.01em\\n  body-md:\\n    fontFamily: DM Sans\\n    fontSize: 14px\\n    fontWeight: '400'\\n    lineHeight: '1.85'\\n  label-uppercase:\\n    fontFamily: DM Sans\\n    fontSize: 12px\\n    fontWeight: '500'\\n    lineHeight: '1.2'\\n    letterSpacing: 0.15em\\n  caption:\\n    fontFamily: DM Sans\\n    fontSize: 11px\\n    fontWeight: '500'\\n    lineHeight: '1.4'\\n    letterSpacing: 0.05em\\nrounded:\\n  sm: 0.25rem\\n  DEFAULT: 0.5rem\\n  md: 0.75rem\\n  lg: 1rem\\n  xl: 1.5rem\\n  full: 9999px\\nspacing:\\n  container-max: 1440px\\n  section-gap-desktop: 80px\\n  section-gap-mobile: 48px\\n  grid-gutter: 24px\\n  element-gap-sm: 8px\\n  element-gap-md: 16px\\n  element-gap-lg: 32px\\n---\\n\\n## Brand \\u0026 Style\\n\\nThe brand identity centers on **Ethical Luxury**—a harmony between artisanal craftsmanship and sustainable consciousness. It targets a discerning audience that values \\\"Quiet Luxury,\\\" where quality is felt through texture and space rather than loud logos.\\n\\nThe design style is **Refined Minimalism**. It leverages heavy whitespace to create \\\"breathing room,\\\" allowing high-quality imagery and sophisticated typography to take center stage. The aesthetic is warm and organic, moving away from cold, clinical minimalism toward a more tactile, human-centric experience. Visual interest is generated through:\\n- **Sophisticated Layering:** Using background color shifts and subtle blurs rather than heavy shadows.\\n- **Organic Geometry:** A mix of large-radius containers and pill-shaped interactive elements.\\n- **Editorial Polish:** High-contrast typography that mirrors premium print magazines.\\n\\n## Colors\\n\\nThe palette is inspired by natural, undyed fibers and earthen materials. \\n\\n- **Primary (Clay):** Used for call-to-actions, price accents, and critical indicators. It provides a warm, energetic contrast to the neutral base.\\n- **Secondary (Ink):** The foundation for readability. Used for all primary headings and body text to ensure high legibility against light backgrounds.\\n- **Tertiary (Blush):** A soft accent for secondary surfaces, card backgrounds, and promotional banners.\\n- **Neutral (Cream):** The primary canvas. This off-white base reduces eye strain and feels more premium and \\\"organic\\\" than pure white.\\n- **Named Colors:** **Sage** is reserved for eco-specific callouts or decorative elements to reinforce the sustainability narrative. **Ink-light** is used for secondary navigation and metadata to create visual hierarchy.\\n\\n## Typography\\n\\nThis design system employs a high-contrast pairing to balance heritage and modernity.\\n\\n- **Headlines:** Use **DM Serif Display**. Its graceful curves and high contrast evoke luxury and editorial authority. Use it sparingly for section headers and hero statements.\\n- **Body \\u0026 UI:** Use **DM Sans**. This low-contrast geometric sans-serif ensures maximum legibility across all digital interfaces. \\n- **The \\\"Label-Uppercase\\\" Style:** This is a signature brand element. Use it for navigation, small headings over titles, and button labels. The generous letter-spacing (tracking) is essential to achieving the \\\"premium\\\" feel.\\n- **Line Height:** Maintain a generous line height (1.8 - 1.85) for body text to reinforce the airy, spacious aesthetic.\\n\\n## Layout \\u0026 Spacing\\n\\nThe layout philosophy follows a **Fluid Grid** model with extreme emphasis on vertical breathing room.\\n\\n- **Grid:** Use a 12-column grid for desktop and a 2-column grid for mobile. \\n- **Margins:** Desktop margins should be at least 64px to create a \\\"framed\\\" editorial look. Mobile margins should be 20px.\\n- **Vertical Spacing:** Use `section-gap-desktop` (80px) between major content blocks. This intentional \\\"over-spacing\\\" is what differentiates the design from standard e-commerce layouts.\\n- **Alignment:** Center-align hero content and primary section titles to maintain a formal, balanced feel. Use left-alignment for product grids and content-heavy blocks.\\n\\n## Elevation \\u0026 Depth\\n\\nThis design system avoids heavy drop shadows in favor of **Tonal Layering** and **Atmospheric Depth**.\\n\\n- **Surface Tiers:** Depth is indicated by shifting background colors (e.g., a `Blush` card on a `Cream` background).\\n- **Glassmorphism:** Use `backdrop-blur` (8px to 12px) for sticky headers and floating badges. This creates a sense of lightness and transparency.\\n- **Subtle Elevation:** For interactive states (like hover on product cards), use a very soft, low-opacity shadow: `0 10px 30px rgba(42, 36, 32, 0.05)`. The shadow should feel like a soft ambient light rather than a hard edge.\\n- **Transitions:** All elevation changes should be paired with a subtle vertical translation (e.g., `translateY(-4px)`) to provide tactile feedback.\\n\\n## Shapes\\n\\nThe shape language is \\\"Soft-Modern,\\\" utilizing rounded corners to evoke friendliness and comfort—qualities essential to a wearable fashion brand.\\n\\n- **Small Elements (Buttons, Tags, Pills):** Use `rounded-full` (pill-shaped). This creates a distinct interactive language that feels modern and approachable.\\n- **Medium Elements (Product Images, Floating Cards):** Use `rounded-lg` (1rem / 16px). This softens the grid without making it feel juvenile.\\n- **Large Elements (Banners, Testimonial Containers):** Use `rounded-xl` (1.5rem / 24px) to create \\\"enveloping\\\" containers that feel substantial and high-end.\\n\\n## Components\\n\\n### Buttons\\n- **Primary:** Pill-shaped, `Clay` background, white text, `label-uppercase` typography. \\n- **Secondary:** Pill-shaped, `Ink` border (1px), `Ink` text. Hover state fills the background with `Ink` and changes text to `Cream`.\\n- **Ghost:** No border, `label-uppercase` text with a subtle underline that expands on hover.\\n\\n### Input Fields\\n- **Style:** Underlined or very soft borders (`border-subtle`). \\n- **Focus State:** Border color shifts to `Clay`.\\n- **Typography:** Placeholder text in `Ink-light` using `body-md`.\\n\\n### Cards\\n- **Product Cards:** No visible borders. Imagery uses `rounded-lg`. Product name and price are stacked below with `element-gap-sm`. On hover, the image should subtly scale or lift.\\n- **Testimonial/Category Cards:** Use `Blush` or `Sage` backgrounds with `rounded-xl`. \\n\\n### Chips \\u0026 Filters\\n- **Style:** Always pill-shaped (`rounded-full`). \\n- **Active State:** `Clay` background with white text.\\n- **Inactive State:** `Cream-warm` background or 1px `border-subtle`.\\n\\n### Navigation\\n- **Header:** Sticky with `backdrop-blur` and a `Cream` background at 90% opacity. \\n- **Links:** Use `label-uppercase` with 24px horizontal spacing. An active state is indicated by a thin 1px underline.\",6,\"#c97b5a\",\"#2a2420\",\"#f5ede6\",\"#faf7f4\",2,[[\"body-md\",[\"DM Sans\",\"14px\",\"400\",\"1.85\"]],[\"display\",[\"DM Serif Display\",\"80px\",\"400\",\"1.1\",\"-0.02em\"]],[\"caption\",[\"DM Sans\",\"11px\",\"500\",\"1.4\",\"0.05em\"]],[\"label-uppercase\",[\"DM Sans\",\"12px\",\"500\",\"1.2\",\"0.15em\"]],[\"display-mobile\",[\"DM Serif Display\",\"44px\",\"400\",\"1.2\"]],[\"body-lg\",[\"DM Sans\",\"16px\",\"400\",\"1.8\",\"0.01em\"]],[\"headline-lg\",[\"DM Serif Display\",\"40px\",\"400\",\"1.3\"]],[\"headline-md\",[\"DM Serif Display\",\"32px\",\"400\",\"1.3\"]]],[[\"element-gap-lg\",\"32px\"],[\"section-gap-mobile\",\"48px\"],[\"element-gap-sm\",\"8px\"],[\"section-gap-desktop\",\"80px\"],[\"element-gap-md\",\"16px\"],[\"container-max\",\"1440px\"],[\"grid-gutter\",\"24px\"]],null,\"dmSerifDisplay\",\"Dm Sans\",\"Dm Sans\"],null,[[\"00346aaac9194da482e4079d29269f42\",\"projects/18178749605532028059/screens/00346aaac9194da482e4079d29269f42\",5931,-593,512,686,null,null,true],[\"054c78ff2e2c40f5bdfe85da8b5e530c\",\"projects/18178749605532028059/screens/054c78ff2e2c40f5bdfe85da8b5e530c\",19871,-573,1280,2512],[\"090999fa4288499ba4839cd68cad331e\",\"projects/18178749605532028059/screens/090999fa4288499ba4839cd68cad331e\",13703,-560,1280,3049],[\"0fa9b5fe18ca494f987ccd3596b7d757\",\"projects/18178749605532028059/screens/0fa9b5fe18ca494f987ccd3596b7d757\",30680,null,1280,5462,null,null,true],[\"181b45f7de684eaab14b94b41c68f1e4\",\"projects/18178749605532028059/screens/181b45f7de684eaab14b94b41c68f1e4\",5355,-593,512,686,null,null,true],[\"1c37991722fd49c2b256f79a04ebd8d5\",\"projects/18178749605532028059/screens/1c37991722fd49c2b256f79a04ebd8d5\",30368,1510,1280,2643,null,null,true],[\"24203fa3730d49b8bccfd78cb185ada2\",\"projects/18178749605532028059/screens/24203fa3730d49b8bccfd78cb185ada2\",576,16742,512,686,null,null,true],[\"24441743fadc4e1caa9b0b1301acb0d2\",\"projects/18178749605532028059/screens/24441743fadc4e1caa9b0b1301acb0d2\",4011,-593,1280,6934,null,null,true],[\"265483c68abe4654802eca1db6aa0167\",\"projects/18178749605532028059/screens/265483c68abe4654802eca1db6aa0167\",7095,-637,1280,7168],[\"297bd88bb16445e3aaa50107aa6b4c7b\",\"projects/18178749605532028059/screens/297bd88bb16445e3aaa50107aa6b4c7b\",11954,-573,1280,2397],[\"2c5875f1b9ee4c7e8066347e0c72d4a0\",\"projects/18178749605532028059/screens/2c5875f1b9ee4c7e8066347e0c72d4a0\",18272,-593,512,686,null,null,true],[\"3174cdbbacbf49dd8f9b4df7f3b2fbd0\",\"projects/18178749605532028059/screens/3174cdbbacbf49dd8f9b4df7f3b2fbd0\",22621,1510,1280,3525,null,null